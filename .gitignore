# Publish only the public templates and their rule/icon resources.
/*
!/.gitignore
!/.gitattributes
!/hello_openclash.yaml
!/hello_FlClash.yaml
!/hello_Stash.yaml
!/hello_mihomo.yaml
!/hello_Loon.conf
!/hello_QuantumultX.conf
!/rule/
!/mrs/
!/icon/
!/script/
!/module/
/script/*
!/script/resource-parser.js
!/script/README.md
/module/*
!/module/Loopback.loon.lpx

/rule/*
!/rule/*.yaml
!/rule/*.loon.list
!/rule/*.qx.list
!/rule/SOURCES.md
/mrs/*
!/mrs/*.mrs
!/mrs/README.md
/icon/*
!/icon/*.png
!/icon/*.svg
!/icon/*.md
!/icon/geometry-and-qure.txt

# Defense in depth if a private directory is accidentally copied here.
**/local/
**/mylocal/
**/providers/
**/.env*
**/*private*
**/*subscription*

# Public private-network rules contain no node credentials.
!/rule/Private.loon.list
!/rule/Private.qx.list
